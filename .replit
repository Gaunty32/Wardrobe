modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
DPD_SENDER_NAME = "Select Branding Solutions"
DPD_SENDER_LINE1 = "Spence Mills, Mill Lane"
DPD_SENDER_TOWN = "Leeds"
DPD_SENDER_POSTCODE = "LS13 3HE"
DPD_NETWORK_CODE = "1"
SMTP_HOST = "smtp.office365.com"
SMTP_PORT = "587"
SMTP_SECURE = "false"
SMTP_FROM = "Select Branding Solutions <noreply@selectuniforms.co.uk>"
